{
  "name": "@francav/profiles",
  "version": "0.1.1",
  "description": "DPG reference runtime-profile packs (camunda-7, camunda-8, cib-seven, operaton) validating against the L1 runtime-profile schema",
  "license": "Apache-2.0",
  "author": "Victor França",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/francav/dpg-spec.git",
    "directory": "packages/profiles"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./packs/*": "./packs/*.json"
  },
  "files": [
    "dist",
    "packs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "lint": "eslint .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@francav/spec": "^0.1.0"
  }
}
