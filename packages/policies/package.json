{
  "name": "@francav/policies",
  "version": "0.1.1",
  "description": "DPG reference governance-policy packs (baseline-tier-1, baseline-tier-2) validating against the L1 policy schema",
  "license": "Apache-2.0",
  "author": "Victor França",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/francav/dpg-spec.git",
    "directory": "packages/policies"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./packs/*": "./packs/*.json"
  },
  "files": [
    "dist",
    "packs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "lint": "eslint .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@francav/spec": "^0.1.0"
  }
}
