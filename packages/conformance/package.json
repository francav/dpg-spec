{
  "name": "@francav/conformance",
  "version": "0.1.0",
  "description": "DPG conformance suite: CC0 BPMN/DMN fixtures plus golden CompilerResult vectors for verifying a DPG-conformant compiler",
  "license": "CC0-1.0",
  "author": "Victor França",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/francav/dpg-spec.git",
    "directory": "packages/conformance"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./fixtures/*": "./fixtures/*",
    "./vectors/*": "./vectors/*.json"
  },
  "files": [
    "dist",
    "fixtures",
    "vectors",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "fixtures": "node ./scripts/run-fixtures.mjs",
    "lint": "eslint .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@francav/spec": "^0.1.0"
  }
}
