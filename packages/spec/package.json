{
  "name": "@francav/spec",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schemas/*": "./schemas/*.json"
  },
  "files": [
    "dist",
    "schemas"
  ],
  "scripts": {
    "build": "tsc -b",
    "gen:types": "node scripts/gen-types.mjs",
    "test": "vitest run",
    "lint": "eslint .",
    "format:check": "prettier --check ."
  }
}
