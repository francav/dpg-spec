{
  "name": "@francav/spec",
  "version": "0.1.1",
  "description": "DPG L1 spec: normative JSON Schemas (draft 2020-12) for the compiler's public I/O contract, with the TypeScript types derived from them",
  "license": "Apache-2.0",
  "author": "Victor França",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/francav/dpg-spec.git",
    "directory": "packages/spec"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schemas/*": "./schemas/*.json"
  },
  "files": [
    "dist",
    "schemas",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -b",
    "gen:types": "node scripts/gen-types.mjs",
    "test": "vitest run",
    "lint": "eslint .",
    "format:check": "prettier --check ."
  }
}
